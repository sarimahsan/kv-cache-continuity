# ==============================================================================
# Git Ignore Configuration: kv-cache-continuity
# ==============================================================================

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ipynb_checkpoints/

# Virtual environments
venv/
.venv/
env/
.env

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Manuscript folder (keep local, do not push)
manuscript/

# Large foundation model weights (> 100MB)
*.safetensors
*.bin
*.ckpt
*.onnx
base_model.pt

# Training logs & tracking
runs/
wandb/
tensorboard/
*.log


# LaTeX build artifacts & temporary files
*.aux
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)
*.out
*.toc
*.nav
*.snm
*.vrb
*.bak
*.swp
*~